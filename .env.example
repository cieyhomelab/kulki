# Zmienne środowiskowe projektu. Żadna nie jest sekretem i żadna nie jest wymagana:
# gra nie ma backendu ani integracji zewnętrznych.
#
# Lokalnie: skopiuj do .env (Docker Compose wczyta go sam).
# Sekrety agentów i CI, gdyby kiedyś się pojawiły, trafiają do
# ${SH_SECRETS_DIR:-$HOME/.sh-secrets}/kulki.env, nigdy do repozytorium.

# Port na hoście, pod którym `docker compose up` wystawia grę.
# Opcjonalna, domyślnie 8080. Nie dotyczy testów E2E (nie publikują portów).
WEB_PORT=8080

# Identyfikator przebiegu testów E2E; nazwa projektu Compose to e2e-${E2E_RUN_ID}.
# Opcjonalna, domyślnie losowa. Ustawiaj w wywołaniu skryptu, nie w .env.
# E2E_RUN_ID=

# Katalog z plikami sekretów czytanymi przez scripts/test-e2e.sh.
# Opcjonalna, domyślnie $HOME/.sh-secrets.
# SH_SECRETS_DIR=

# Adres, pod którym projekt `postdeploy` testów E2E sprawdza opublikowaną grę,
# np. https://cieyhomelab.github.io/kulki/. Opcjonalna; pusta oznacza tryb atrapy:
# sprawdzana jest usługa `web` z tymczasowego stosu Compose. Ustawiaj w wywołaniu skryptu.
# POSTDEPLOY_URL=

# Identyfikator wersji wstawiany do pliku gry (<meta name="kulki-version">).
# Opcjonalna; pusta albo nieustawiona oznacza `dev`. Dozwolone: `dev` albo 40 znaków 0-9a-f
# (inna wartość kończy budowanie błędem). Ustawiaj w wywołaniu skryptu, np. w CI.
# KULKI_VERSION=

# Oczekiwana wartość znacznika wersji w projekcie `postdeploy`.
# Opcjonalna, domyślnie `dev`. Ustawiaj w wywołaniu skryptu.
# POSTDEPLOY_VERSION=

# Oczekiwana suma SHA-256 pliku gry (64 znaki szesnastkowe) w projekcie `postdeploy`.
# Opcjonalna; pusta oznacza sumę pliku dist/index.html w kontenerze testów.
# POSTDEPLOY_SHA256=

# Czas (sekundy epoki Unix), do którego projekt `postdeploy` ponawia czekanie na wersję
# i na kody 404. Opcjonalna; pusta oznacza 30 s na każdy krok czekania. Ustawiaj w wywołaniu skryptu.
# POSTDEPLOY_DEADLINE=
