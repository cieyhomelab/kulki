# Zmienne środowiskowe projektu. Żadna nie jest sekretem i żadna nie jest wymagana:
# gra nie ma backendu ani integracji zewnętrznych.
#
# Lokalnie: skopiuj do .env (Docker Compose wczyta go sam).
# Sekrety agentów i CI, gdyby kiedyś się pojawiły, trafiają do
# ${SH_SECRETS_DIR:-$HOME/.sh-secrets}/kulki.env, nigdy do repozytorium.

# Port na hoście, pod którym `docker compose up` wystawia grę.
# Opcjonalna, domyślnie 8080. Nie dotyczy testów E2E (nie publikują portów).
WEB_PORT=8080

# Identyfikator przebiegu testów E2E; nazwa projektu Compose to e2e-${E2E_RUN_ID}.
# Opcjonalna, domyślnie losowa. Ustawiaj w wywołaniu skryptu, nie w .env.
# E2E_RUN_ID=

# Katalog z plikami sekretów czytanymi przez scripts/test-e2e.sh.
# Opcjonalna, domyślnie $HOME/.sh-secrets.
# SH_SECRETS_DIR=
